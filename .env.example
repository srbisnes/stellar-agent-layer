# ─────────────────────────────────────────────────────────────
# Stellar Agent Layer — Environment Variables
# Copy this file to .env and fill in the values you need.
# ─────────────────────────────────────────────────────────────

# Stellar Network Configuration (Testnet)
STELLAR_NETWORK="testnet"
HORIZON_URL="https://horizon-testnet.stellar.org"
FRIENDBOT_URL="https://friendbot.stellar.org"

# Gemini AI API Key (optional — improves conversational agent;
# without it the local Intent Engine still works offline)
GEMINI_API_KEY="TU_API_KEY_AQUI"

# Google Identity Services (optional — without it, Demo Login is used)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Server port
PORT=3000
