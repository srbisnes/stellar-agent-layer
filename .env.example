# OpenAI (or compatible) for the Intent Engine + Tool Calling
OPENAI_API_KEY=sk-...

# Optional: use a different base URL (e.g. Groq, Together, local)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Stellar Network (testnet by default)
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# ─────────────────────────────────────────────
# Clerk Auth (Google login + multi-user)
# 1. Create app at https://dashboard.clerk.com
# 2. Enable Google as social provider
# 3. Copy the keys below
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional Clerk paths (defaults work fine)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Security: never put real secret keys in env for production agents
# The demo generates ephemeral keys client-side / session-side
