# OpenAI (or compatible) for the Intent Engine + Tool Calling
OPENAI_API_KEY=sk-...

# Optional: use a different base URL (e.g. Groq, Together, local)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Stellar Network (testnet by default)
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# ─────────────────────────────────────────────
# Clerk Auth (Google login + multi-user web)
# https://dashboard.clerk.com
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─────────────────────────────────────────────
# Telegram Bot (channel)
# 1. Talk to @BotFather on Telegram → /newbot
# 2. Copy the token
# 3. After deploy, call POST /api/telegram/setup
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_SETUP_SECRET=change-me-to-a-random-string

# Public URL of your app (Vercel domain or custom)
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Security: never put real mainnet secrets here
