# OpenAI (or compatible) for the Intent Engine + Tool Calling
OPENAI_API_KEY=sk-...

# Optional: use a different base URL (e.g. Groq, Together, local)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Stellar Network (testnet by default)
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# ─────────────────────────────────────────────
# Clerk Auth (Google login + multi-user web)
# https://dashboard.clerk.com
# ─────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─────────────────────────────────────────────
# Telegram Bot
# @BotFather → /newbot → token
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_SETUP_SECRET=change-me-to-a-random-string

# ─────────────────────────────────────────────
# WhatsApp Business Cloud API (Meta)
# 1. https://developers.facebook.com/ → Create App → Business
# 2. Add product: WhatsApp
# 3. Copy Phone number ID + Temporary (or permanent) access token
# 4. Set a Verify Token (any secret string you choose)
# 5. Webhook URL: https://YOUR_DOMAIN/api/whatsapp/webhook
#    Subscribe to: messages
# ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=stellar-agent-verify-change-me

# Public URL of your app
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Security: never put real mainnet secrets here
