# OpenAI (or compatible) for the Intent Engine + Tool Calling
OPENAI_API_KEY=sk-...

# Optional: use a different base URL (e.g. Groq, Together, local)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Stellar Network (testnet by default)
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
FRIENDBOT_URL=https://friendbot.stellar.org

# Security: never put real secret keys in env for production agents
# The demo generates ephemeral keys client-side / session-side